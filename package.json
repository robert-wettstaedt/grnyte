{
  "name": "grnyte",
  "version": "0.0.1",
  "private": true,
  "homepage": "http://grnyte.rocks",
  "repository": {
    "type": "git",
    "url": "https://github.com/robert-wettstaedt/grnyte"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:zero": "npx zero-cache-dev",
    "build": "vite build",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "check": "npm run generate:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:prod": "npx tsx deployment/check-prod.ts",
    "secrets:pull": "node deployment/secrets.mjs pull",
    "secrets:pull:dev": "BWS_ACCESS_TOKEN=$(security find-generic-password -s bws-grnyte-dev -w) npm run secrets:pull",
    "secrets:pull:demo": "BWS_ACCESS_TOKEN=$(security find-generic-password -s bws-grnyte-demo -w) npm run secrets:pull",
    "secrets:pull:prod": "BWS_ACCESS_TOKEN=$(security find-generic-password -s bws-grnyte-prod -w) npm run secrets:pull",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "eslint --fix . && prettier --write .",
    "generate": "npm run generate:drizzle && npm run generate:zero && npx tsx src/lib/email/generate.ts",
    "migrate": "npx tsx src/lib/db/migrate.ts",
    "generate:drizzle": "drizzle-kit generate --config drizzle.config.ts",
    "generate:zero": "drizzle-zero generate --format --output src/lib/zero/zero-schema.gen.ts",
    "generate:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable cookie preferredLanguage baseLocale --silent",
    "generate:pwa": "pwa-assets-generator",
    "machine-translate": "inlang machine translate --project project.inlang",
    "storybook": "BROWSER=none storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@lucide/svelte": "^1.17.0",
    "@paralleldrive/cuid2": "^3.0.0",
    "@rocicorp/zero": "^1.9.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "@types/heic-convert": "^2.1.0",
    "d3": "^7.9.0",
    "diff": "^9.0.0",
    "drizzle-zero": "^0.20.0",
    "emoji-picker-element": "^1.29.1",
    "exifr": "~7.1.3",
    "github-markdown-css": "^5.8.1",
    "gsap": "^3.15.0",
    "heic-convert": "^2.1.0",
    "hls.js": "^1.6.16",
    "jose": "^5.10.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "ol": "^10.0.0",
    "postgres": "^3.4.9",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "resend": "^6.0.0",
    "sharp": "^0.35.4",
    "svelte-bottom-sheet": "^2.3.0",
    "svelte-dnd-action": "^0.9.70",
    "tailwindcss": "^4.0.11",
    "three": "^0.184.0",
    "tus-js-client": "^4.3.1",
    "unified": "^11.0.4",
    "unist-util-visit": "^5.0.0",
    "web-push": "^3.6.7",
    "webdav": "^5.8.0",
    "zero-svelte": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@inlang/cli": "^3.0.0",
    "@inlang/paraglide-js": "^2.18.1",
    "@playwright/test": "^1.61.1",
    "@skeletonlabs/skeleton": "^4.0.0",
    "@skeletonlabs/skeleton-svelte": "^4.14.0",
    "@standard-schema/spec": "^1.1.0",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-docs": "10.4.1",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "10.4.1",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.6",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^28.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.5.0",
    "@types/three": "^0.184.1",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vite-pwa/sveltekit": "^1.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.0",
    "emoji-picker-element-data": "^1.8.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-storybook": "10.4.1",
    "eslint-plugin-svelte": "^3.16.0",
    "globals": "^16.0.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "10.4.1",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "type": "module",
  "volta": {
    "node": "24.16.0"
  }
}
