{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/hooks.ts",
    "src/sw.ts",
    "src/lib/db/scripts/*.ts",
    "src/lib/email/push-templates.ts",
    "src/lib/email/test-send.ts",
    "src/lib/entities/user/users.remote.ts",
    "deployment/announce.ts",
    "memlab/*.cjs",
    "stryker/vitest.config.ts"
  ],
  "ignore": ["src/lib/zero/**/*.gen.ts", "brand/**"],
  "ignoreBinaries": ["openssl"],
  "ignoreUnresolved": ["vite-plugin-pwa/info", "vite-plugin-pwa/vanillajs", "vite-plugin-pwa/pwa-assets"],
  "ignoreExportsUsedInFile": true
}
