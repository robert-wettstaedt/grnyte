# When set, will automatically fill out the login form fields
PUBLIC_DEMO_MODE=

# Will be rendered in the nav bar
PUBLIC_APPLICATION_NAME=crag-track

# Will be rendered on exported PDF
PUBLIC_TOPO_EMAIL=

# Credentials to send emails (https://resend.com/)
RESEND_SENDER_EMAIL=
RESEND_API_KEY=

# URL to your Supabase project (https://supabase.com/dashboard/project/_/settings/api)
PUBLIC_SUPABASE_URL=
# anon key to your Supabase project (https://supabase.com/dashboard/project/_/settings/api)
PUBLIC_SUPABASE_ANON_KEY=
# service_role key (https://supabase.com/dashboard/project/_/settings/api) - server only, used by the cleanup cron to sweep the staging bucket across all users
SUPABASE_SERVICE_ROLE_KEY=
# URI to your Supabase database (https://supabase.com/dashboard/project/_?showConnect=true)
DATABASE_URL=

# URL to your Nextcloud instance
NEXTCLOUD_URL=
# Credentials of the Nextcloud user that users can access files from
NEXTCLOUD_USER_NAME=
NEXTCLOUD_USER_PASSWORD=

# Bunny Stream video hosting (https://dash.bunny.net/stream)
BUNNY_STREAM_API_KEY=
PUBLIC_BUNNY_STREAM_LIBRARY_ID=
PUBLIC_BUNNY_STREAM_HOSTNAME=

# Shared secret the Supabase pg_cron jobs send as x-api-key to POST /api/tasks/cleanup-uploads
# and POST /api/tasks/notifications
CRON_API_KEY=

# Web Push (VAPID) key pair, used to sign every push. Generate one with `npx web-push generate-vapid-keys`.
# The public half is shipped to the browser and handed to PushManager.subscribe; the private half signs.
# Rotating them invalidates every existing subscription, so every device has to subscribe again.
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=

# Shared password of the local seed logins, used by the Playwright suite (npm run test:e2e)
E2E_PASSWORD=
