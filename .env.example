# Copy to .env and fill in, or run `npm run secrets:pull` to write .env from Bitwarden Secrets
# Manager, which holds the real values for dev, demo and prod (see deployment/SECRETS.md).
#
# `pull` rewrites the whole file from the project, so a machine-local value you want to keep has to
# live in the dev project too, not only on disk.
#
# Grouped by the service the value comes from, sorted inside each group.

# --- App ---

# Rendered in the nav bar
PUBLIC_APPLICATION_NAME=grnyte
# When set, will automatically fill out the login form fields
PUBLIC_DEMO_MODE=
# Rendered on exported PDFs
PUBLIC_TOPO_EMAIL=
# Published as the address for illegal-content notices under Art. 16 DSA
PUBLIC_REPORT_EMAIL=


# --- Supabase (https://supabase.com/dashboard/project/_/settings/api) ---

# URI to your Supabase database (https://supabase.com/dashboard/project/_?showConnect=true)
DATABASE_URL=
# anon key to your Supabase project
PUBLIC_SUPABASE_ANON_KEY=
# URL to your Supabase project
PUBLIC_SUPABASE_URL=
# service_role key, server only, used by the cleanup cron to sweep the staging bucket across all users
SUPABASE_SERVICE_ROLE_KEY=
# The project JWT secret, which every Supabase access token is signed with. The server verifies
# every token against it before trusting a `sub`, so a wrong or missing value signs everybody out.
# Byte-identical to ZERO_AUTH_SECRET on the Zero server: rotate the two together or sync breaks.
# Read through $env/static/private, so it is inlined at build time and pushing it needs a redeploy.
SUPABASE_JWT_SECRET=
# Set once the project moves to asymmetric JWT signing keys, after which the secret above can go.
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=
# Optional. Pins the expected `iss`. Leave empty locally: this stack GoTrue sets no issuer, so
# local tokens carry none and pinning one would reject every one of them.
SUPABASE_JWT_ISSUER=


# --- Zero, client half ---

# Where the browser reaches zero-cache. Locally that is `npm run dev:zero` on :4848
PUBLIC_ZERO_URL=

# --- Zero, server half (zero-cache, and the only variables deploy-zero.yml sends to the VPS) ---

# Password for the zero-cache admin endpoints
ZERO_ADMIN_PASSWORD=
# JWT verification secret, the same one Supabase signs its tokens with
ZERO_AUTH_SECRET=
ZERO_CVR_MAX_CONNS=
# Forwards the browser's cookies to the get-queries endpoint. Set to true wherever the app
# authenticates by cookie, which is everywhere but a token-only setup
# ZERO_GET_QUERIES_FORWARD_COOKIES=
# The app's get-queries endpoint. docker-compose.yml falls back to
# http://localhost:3000/api/zero/get-queries
ZERO_GET_QUERIES_URL=
ZERO_NUM_SYNC_WORKERS=
# Where zero-cache keeps its SQLite replica. docker-compose.yml falls back to /data/sync-replica.db
ZERO_REPLICA_FILE=
# docker-compose.yml falls back to src/lib/zero/zero-schema.ts
ZERO_SCHEMA_PATH=
# The database zero-cache replicates from, usually the same one as DATABASE_URL
ZERO_UPSTREAM_DB=
ZERO_UPSTREAM_MAX_CONNS=

# --- Nextcloud, image storage ---

# URL to your Nextcloud instance
NEXTCLOUD_URL=
# Credentials of the Nextcloud user that users can access files from
NEXTCLOUD_USER_NAME=
NEXTCLOUD_USER_PASSWORD=

# --- Bunny Stream, video hosting (https://dash.bunny.net/stream) ---

BUNNY_STREAM_API_KEY=
PUBLIC_BUNNY_STREAM_HOSTNAME=
PUBLIC_BUNNY_STREAM_LIBRARY_ID=

# --- Resend, transactional email (https://resend.com/) ---

RESEND_API_KEY=
RESEND_SENDER_EMAIL=

# --- Web Push (VAPID), optional ---

# Key pair used to sign every push, generated with `npx web-push generate-vapid-keys`. The public
# half is shipped to the browser and handed to PushManager.subscribe; the private half signs.
# Leave both unset to run without push. Rotating them invalidates every existing subscription, so
# every device has to subscribe again.
PRIVATE_VAPID_KEY=
PUBLIC_VAPID_KEY=

# --- Scheduled jobs ---

# Shared secret the Supabase pg_cron jobs send as x-api-key to POST /api/tasks/cleanup-uploads
# and POST /api/tasks/notifications
CRON_API_KEY=

# --- Tests (npm run test:e2e) ---

# The deployment to test against. Unset means the local dev server on :3000
E2E_BASE_URL=
# Shared password of the local seed logins
E2E_PASSWORD=
# Path to a Chromium binary, if Playwright should not use its own
PLAYWRIGHT_CHROMIUM_PATH=

# BWS_ACCESS_TOKEN belongs in your shell, not here: `pull` would overwrite the file that holds it.
